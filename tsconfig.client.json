{
    "exclude": [
        "dist",
        "build"
    ],
    "include": [
        "lib/**/*.client.d.ts",
        "src/**/*.client.js"
    ],
    "compilerOptions": {
        "rootDir": "./src",
        "types": ["angular","jquery"],
        "module": "esnext",
        "target": "es2020",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true
    }
}